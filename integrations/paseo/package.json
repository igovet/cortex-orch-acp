{
  "name": "cortex-paseo-plugin",
  "private": true,
  "type": "module",
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test:qualification-binding": "node --experimental-strip-types server/qualification-binding.test.ts",
    "test:activation": "node --experimental-strip-types server/plugin-activation.test.ts",
    "test:steer": "node --experimental-strip-types server/provider-steer.test.ts && node --experimental-strip-types server/provider-question.test.ts && node --experimental-strip-types server/provider-question-batch.test.ts",
    "test:installed-questions": "node --experimental-strip-types server/installed-questions.test.ts",
    "test:native-queue": "node --experimental-strip-types server/installed-native-queue.test.ts",
    "test:diff": "node --experimental-strip-types client/worker-panel-diff.test.ts",
    "test:status": "node --experimental-strip-types client/worker-panel-status.test.ts",
    "test:display": "node --experimental-strip-types client/worker-display.test.ts",
    "test:terminal-status": "node --experimental-strip-types client/worker-terminal-status.test.ts",
    "test:replay": "node --experimental-strip-types server/replay.test.ts",
    "test:coalesce": "node --experimental-strip-types client/coalesce.test.ts",
    "test:worker-result-batch": "node --experimental-strip-types client/worker-result-batch.test.ts",
    "test:rpc-subscribe": "node --experimental-strip-types client/rpc-subscribe.test.ts",
    "test:python-runner": "node --experimental-strip-types server/python-runner.test.ts",
    "test:invoke-diagnostics": "node --experimental-strip-types server/invoke-diagnostics.test.ts",
    "test:worker-history": "node --experimental-strip-types server/worker-history.test.ts",
    "test:worker-history-concurrency": "node --experimental-strip-types server/worker-history-concurrency.test.ts",
    "test:worker-results": "node --experimental-strip-types server/worker-results.test.ts",
    "test:pipeline": "node --experimental-strip-types server/pipeline.test.ts",
    "test:config": "node --experimental-strip-types server/config.test.ts",
    "test:settings": "node --experimental-strip-types client/settings-model.test.ts && node --experimental-strip-types client/settings-panel.test.ts",
    "test:error-boundary": "node --experimental-strip-types client/plugin-error-boundary.test.ts",
    "test:client-bundle": "node --experimental-strip-types client/client-bundle.test.ts"
  },
  "devDependencies": {
    "@getpaseo/client": "^0.9.1",
    "@getpaseo/plugin": "^0.9.1",
    "@getpaseo/protocol": "^0.9.1",
    "@types/node": "^20.9.0",
    "@types/react": "~19.2.0",
    "esbuild": "^0.25.12",
    "react": "19.1.0",
    "react-native": "0.81.5",
    "typescript": "^5.9.3",
    "zod": "^4.4.3"
  }
}
