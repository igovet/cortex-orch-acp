{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Cortex Workspace Dev",
  "version": "1.0.6",
  "identifier": "dev.cortex.workspace.development",
  "build": {
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [],
    "withGlobalTauri": false,
    "security": {
      "capabilities": [
        "main"
      ],
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; font-src 'self'; connect-src ipc: http://ipc.localhost; object-src 'none'; base-uri 'none'; frame-src 'none'; form-action 'none'"
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "deb"
    ],
    "category": "DeveloperTool",
    "icon": [
      "icons/icon.png"
    ],
    "shortDescription": "Cortex local desktop workspace"
  }
}
