{
  "identifier": "main",
  "description": "Only the bundled main view can use the closed phone bridge, receive its events and open the QR scanner.",
  "local": true,
  "windows": [
    "main"
  ],
  "permissions": [
    "allow-workspace-request",
    "allow-phone-info",
    "allow-phone-state",
    "allow-phone-pair-begin",
    "allow-phone-pair-finish",
    "allow-phone-pair-cancel",
    "allow-phone-select",
    "allow-phone-rename",
    "allow-phone-forget",
    "allow-phone-retry",
    "allow-phone-listen",
    "allow-phone-exit",
    "core:event:allow-listen",
    "core:event:allow-unlisten",
    "core:app:allow-register-listener",
    "core:app:allow-remove-listener",
    "barcode-scanner:allow-scan",
    "barcode-scanner:allow-cancel",
    "barcode-scanner:allow-check-permissions",
    "barcode-scanner:allow-request-permissions"
  ]
}
