# Copy to .env and edit. Never commit .env.

# Public host name of the relay; must have a DNS record pointing at the server.
RELAY_HOST=relay.example.com

# Pinned image tag; change it to upgrade or roll back.
RELAY_IMAGE_TAG=v1.4.1

# Traefik attachment (names of the existing Traefik setup).
TRAEFIK_NETWORK=traefik
TRAEFIK_ENTRYPOINTS=websecure
TRAEFIK_TLS=true

# Log filter (RUST_LOG syntax).
RELAY_LOG=info
