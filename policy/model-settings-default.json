  "mcp_servers": {
    "codebase-memory-mcp": {
      "command": "/path/to/codebase-memory-mcp",
      "args": [],
      "env": {},
      "enabled": false,
      "allowed_tools": [
        "index_repository",
        "search_graph",
        "query_graph",
        "trace_path",
        "get_code_snippet",
        "get_graph_schema",
        "get_architecture",
        "search_code",
        "list_projects",
        "delete_project",
        "index_status",
        "check_index_coverage",
        "detect_changes",
        "manage_adr",
        "ingest_traces"
