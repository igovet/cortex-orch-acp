[Unit]
Description=Cortex Workspace Dev local service
StartLimitIntervalSec=60
StartLimitBurst=5

[Service]
Type=simple
UMask=0077
Environment=PATH=/usr/local/bin:/usr/bin:/bin
ExecStart=/usr/bin/cortex-workspace-service-dev / /usr/lib/cortex-workspace-dev/runtime
RuntimeDirectory=cortex-workspace-dev
RuntimeDirectoryMode=0700
Restart=on-failure
RestartSec=5s
KillMode=control-group
# The service and its engines run at normal CPU and disk priority. Task commands (builds,
# tests, renders) run in their own transient scopes (CPUWeight 20, nice 10, idle disk class,
# MemoryHigh 60%, MemoryMax 75% of RAM), so a runaway command is throttled or OOM-killed
# alone and never starves the service. The service keeps a reservation.
MemoryLow=1G
MemoryHigh=60%
TimeoutStopSec=30s

[Install]
WantedBy=default.target
