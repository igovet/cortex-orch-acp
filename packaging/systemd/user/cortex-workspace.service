[Unit]
Description=Cortex Workspace local service
StartLimitIntervalSec=60
StartLimitBurst=5

[Service]
Type=simple
UMask=0077
Environment=PATH=/usr/local/bin:/usr/bin:/bin
ExecStart=/usr/bin/cortex-workspace-service / /usr/bin/python3 /usr/lib/cortex-workspace/runtime
RuntimeDirectory=cortex-workspace
RuntimeDirectoryMode=0700
Restart=on-failure
RestartSec=5s
KillMode=control-group
TimeoutStopSec=30s

[Install]
WantedBy=default.target
