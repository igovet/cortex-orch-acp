#!/bin/sh
# Best effort for active user managers only. Never enable linger or change user data.
[ "$1" = configure ] || exit 0
for directory in /run/user/[0-9]*; do
    [ -S "$directory/bus" ] || continue
    uid="${directory##*/}"
    case "$uid" in *[!0-9]*|'') continue;; esac
    user="$(getent passwd "$uid" | cut -d: -f1)"
    [ -n "$user" ] || continue
    userctl() {
        /usr/bin/timeout 10 /usr/sbin/runuser -u "$user" -- \
            /usr/bin/env XDG_RUNTIME_DIR="$directory" DBUS_SESSION_BUS_ADDRESS="unix:path=$directory/bus" \
            /usr/bin/systemctl --user "$@" >/dev/null 2>&1 || :
    }
    userctl daemon-reload
    userctl try-restart @UNIT@
done
exit 0
