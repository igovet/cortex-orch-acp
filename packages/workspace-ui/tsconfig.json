{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "jsx": "preserve",
    "jsxImportSource": "solid-js",
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "allowImportingTsExtensions": true,
    "resolveJsonModule": true,
    "types": ["vite/client", "node"],
    "paths": {
      "@cortex/workspace-contract": ["../workspace-contract/index.ts"],
      "@cortex/workspace-domain": ["../workspace-domain/src/index.ts"],
      "@cortex/workspace-domain/*": ["../workspace-domain/src/*"]
    }
  },
  "include": ["src", "test", "production", "vite.config.ts"]
}
